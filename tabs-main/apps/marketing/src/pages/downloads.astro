---
import ConceptOneDownload from "../components/download/ConceptOneDownload.astro";
import SiteScripts from "../components/SiteScripts.astro";
import SiteThemeHead from "../components/SiteThemeHead.astro";

import "../styles/concepts.css";
import "../styles/concept-one.css";
---

<!doctype html>
<html lang="en">
  <head>
    <SiteThemeHead />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Download Tabs desktop workspace. Standalone packages for macOS (Apple Silicon & Intel), Windows x64, and Linux AppImage."
    />
    <title>Download Tabs for macOS, Windows, or Linux</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <main id="main">
      <ConceptOneDownload />
    </main>

    <noscript>
      <style>
        [data-concept][hidden] { display: block !important; }
        .concept-rail { display: none; }
      </style>
    </noscript>

    <SiteScripts />
    <script>import "../lib/motion";</script>
  </body>
</html>
