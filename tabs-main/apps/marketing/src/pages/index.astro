---
import Concepts from "../components/Concepts.astro";
import SiteScripts from "../components/SiteScripts.astro";
import PageLoader from "../components/PageLoader.astro";
import SiteThemeHead from "../components/SiteThemeHead.astro";
import "../styles/concepts.css";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width,initial-scale=1"/>
    <meta name="description" content="Every project gets a tab. Bring your code, agents, servers, Git, browser, and your own tools into one desktop window. Tabs: bigger than an IDE."/>
    <meta name="theme-color" content="#fbfcfe"/>
    <title>Tabs — Bigger than an IDE</title>
    <SiteThemeHead />
  </head>
  <body>
    <PageLoader />
    <a class="skip-link" href="#main">Skip to content</a>
    <main id="main"><Concepts /></main>
    <SiteScripts />
    <script>import "../lib/motion"; import "../lib/headspace-motion";</script>
  </body>
</html>
