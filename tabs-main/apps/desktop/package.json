{
  "name": "@tabs/desktop",
  "version": "1.2.122",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "bun run dev:bundle & bun run dev:backend-bundle & bun run dev:electron",
    "dev:bundle": "tsdown --watch",
    "dev:backend-bundle": "bun --cwd=../server run dev:bundle",
    "dev:electron": "bun run scripts/dev-electron.mjs",
    "build": "tsdown",
    "start": "bun run scripts/start-electron.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "smoke-test": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "effect": "catalog:",
    "electron": "44.1.0",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@tabs/contracts": "workspace:*",
    "@tabs/shared": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wait-on": "^8.0.2"
  },
  "productName": "Tabs"
}
