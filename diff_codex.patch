+export const CodexAdapterLive = Layer.effect(CodexAdapter, makeCodexAdapter());
+
+export function makeCodexAdapterLive(options?: CodexAdapterLiveOptions) {
+  return Layer.effect(CodexAdapter, makeCodexAdapter(options));
+}
